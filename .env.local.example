# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_GROUP_RECIPIENT=your-group-phone-number

# App
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
ADMIN_PASSWORD=changeme123

# Web Push (generate with `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CONTACT_EMAIL=admin@example.com

# Sentry error monitoring — create a free project at sentry.io, pick
# "Next.js" as the platform, and copy its DSN below. The app runs fine
# without this set (errors just won't be reported anywhere).
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0
# Optional — only needed to upload source maps for readable stack traces.
# Find these under Sentry → Settings → Auth Tokens / your org & project slugs.
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token
